# Salin ke Environment Variables di Vercel (jangan commit nilai aslinya)
# Pilih salah satu penyedia AI. Jika GEMINI_API_KEY diisi, Gemini yang dipakai.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
APP_PASSWORD=ganti-dengan-kata-sandi-kuat
# Opsional
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_MODEL=claude-sonnet-5-5
SEED_DEMO=true
# Otomatis terisi jika Upstash Redis dihubungkan lewat Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=
